# SPDX-License-Identifier: Apache-2.0
# Copy to .env in this directory. Keep real values out of version control.
COMPOSE_PROJECT_NAME=baton
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# codex is the real worker; demo is explicitly synthetic and needs no model account.
WORKER_MODE=codex
# Optional: choose a model available to your own account; blank uses the CLI default.
CODEX_MODEL=
# Codex worker cgroup memory cap (RSS+swap); default 640m on a ~3.9 GiB host.
CODEX_MEM_LIMIT=640m
# Optional TLS override values (replace paths, do not commit certificates):
# HTTPS_PORT=8443
# PUBLIC_URL=https://example.com:8443
# EDGE_UID=1000
# EDGE_GID=1000
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem
