{
  "_license": "SPDX-License-Identifier: Apache-2.0",
  "config": {
    "logging": {
      "format": "json"
    }
  },
  "frontendPolicies": {
    "accessLog": {
      "add": {
        "agent": "apiKey.agent",
        "request_id": "request.headers[\"x-request-id\"]"
      },
      "remove": [
        "http.path",
        "http.query"
      ]
    }
  },
  "binds": [
    {
      "port": 3000,
      "listeners": [
        {
          "protocol": "HTTP",
          "routes": [
            {
              "name": "baton-space",
              "matches": [
                {
                  "path": {
                    "pathPrefix": "/mcp"
                  }
                },
                {
                  "path": {
                    "pathPrefix": "/board"
                  }
                },
                {
                  "path": {
                    "exact": "/healthz"
                  }
                },
                {
                  "path": {
                    "pathPrefix": "/v1/space/"
                  }
                }
              ],
              "policies": {
                "apiKey": {
                  "keys": [],
                  "mode": "strict",
                  "location": {
                    "header": {
                      "name": "authorization",
                      "prefix": "Bearer "
                    }
                  }
                },
                "transformations": {
                  "request": {
                    "set": {
                      "authorization": "\"Bearer \" + apiKey.key.unredacted()"
                    }
                  }
                },
                "authorization": {
                  "rules": [
                    "apiKey.role == 'client'"
                  ]
                }
              },
              "backends": [
                {
                  "host": "bridge:9000"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
