# SPDX-License-Identifier: Apache-2.0
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY deploy/mail-constraints.txt /app/mail-constraints.txt
# This dependency has its own restricted license; see docs/THIRD_PARTY.md.
RUN pip install --no-cache-dir -c /app/mail-constraints.txt "git+https://github.com/Dicklesworthstone/mcp_agent_mail.git@fd9c518458daa1ac7cf74500aa37ed7bd72b8dd0" && useradd -m -u 10001 agent
WORKDIR /app
COPY bridge/mail_entry.py /app/mail_entry.py
RUN mkdir -p /data && chown agent:agent /data
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HTTP_HOST=0.0.0.0 HTTP_PORT=8765 STORAGE_ROOT=/data/mailbox DATABASE_URL=sqlite+aiosqlite:////data/mail.sqlite3 HTTP_ALLOW_LOCALHOST_UNAUTHENTICATED=false HTTP_RBAC_DEFAULT_ROLE=writer TOOLS_LOG_ENABLED=false LOG_LEVEL=WARNING
CMD ["python", "/app/mail_entry.py"]
